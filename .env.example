# ── Credentials ──────────────────────────────────────────────────────────────
# OpenCode Go + Zen (shared key). Required for opencode-go and opencode-zen.
# Get yours at https://opencode.ai
OPENCODE_API_KEY=sk-your-opencode-key-here

# Kilo Gateway (https://kilo.ai). Optional — anonymous access works for free
# models at 200 req/hr/IP. Set a key for higher limits.
# KILO_API_KEY=your-kilo-key-here

# OpenRouter (https://openrouter.ai). Required for the openrouter provider.
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Local backend (WindsurfAPI on 127.0.0.1:3003).
# Must match the API_KEY in WindsurfAPI/.env
LOCAL_API_KEY=sk-local-test

# WindsurfAPI account token — the Devin CLI session token.
# By default, the shim reads this from ~/.local/share/devin/credentials.toml
# (windsurf_api_key field), which the CLI refreshes automatically. Set
# WINDSURF_API_KEY here only if you want to pin a specific token.
# WINDSURF_API_KEY=devin-session-token$your-token-here
# WINDSURF_CREDENTIALS_PATH=/custom/path/to/credentials.toml

# Disable WindsurfAPI's drought gate to allow free-tier models through.
# The gate's FREE_REACHABLE_SELECTORS list is stale (dwgx/WindsurfAPI#258) and
# blocks swe-1-7, swe-1-7-medium, glm-5.2, glm-5.1 — the models that are
# actually free at 0% weekly quota. The shim config already restricts the
# local provider to only those models.
DROUGHT_RESTRICT_PREMIUM=0

# Vision fallback model — when a request contains images but the resolved
# model doesn't support vision, the shim re-routes to this model instead of
# stripping the images. Must be a model id that exists in the provider config.
VISION_FALLBACK_MODEL=qwen3.8-max

# ── Shim operational settings (optional, shown with defaults) ────────────────
# SHIM_PORT=8788
# SHIM_HOST=127.0.0.1
# SHIM_LOG_DIR=          # directory for tool-schema dumps (empty = disabled)
# SHIM_FAILOVER=true      # set to 0/false to disable provider failover
